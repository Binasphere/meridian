# --- Database -------------------------------------------------------------
# Port 5433 avoids colliding with a Postgres you may already run on 5432.
DATABASE_URL="postgresql://meridian:meridian@localhost:5433/meridian?schema=public"

# --- Auth -----------------------------------------------------------------
# Sessions are JWTs signed with this key. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-secret-please-generate-a-real-one-before-deploying"

# --- Runtime --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Supabase (backend) ---------------------------------------------------
# The app runs on its client-side simulation until these are set; once present,
# features migrate onto Supabase. Both are safe to expose to the browser — only
# the anon/publishable key goes here, never the service-role key. Find them in
# your Supabase project under Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Admin panel (/admin) -------------------------------------------------
# Reading and writing *other people's* profiles is exactly what row-level
# security forbids, so the admin panel runs server-side under the service-role
# key, which bypasses RLS. Secret: no NEXT_PUBLIC_ prefix, never imported into a
# client component. Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Passcode that unlocks /admin. Empty disables the panel entirely — there is no
# default passcode, because a guessable one is worse than a locked door.
ADMIN_PASSCODE=""

# --- PayHero (real M-Pesa deposits) ---------------------------------------
# From the PayHero dashboard (app.payhero.co.ke): Settings → API Keys for the
# username/password pair, Payment Channels → My Payment Channels for the
# numeric channel id of your till/paybill. All three are secrets.
# Every value in this section (and above) can alternatively live in the
# gitignored secrets.local.json — see secrets.example.json and GO-LIVE.md.
PAYHERO_USERNAME=""
PAYHERO_PASSWORD=""
PAYHERO_CHANNEL_ID=""

# Public origin PayHero calls back on. Normally derived from proxy headers;
# set only if deposits fail with an unreachable callback URL.
# PUBLIC_BASE_URL="https://your-domain.example"

# --- Price oracle ---------------------------------------------------------
# "simulated" runs the built-in server-authoritative price engine (no network,
# no API keys). The PriceOracle interface is the seam where a real market-data
# provider drops in — see src/server/oracle/types.ts.
PRICE_ORACLE=simulated

# Fixes the simulated feed's PRNG so a run is reproducible (useful for tests
# and demos). Leave unset for a fresh random walk on every boot.
# ORACLE_SEED=42
